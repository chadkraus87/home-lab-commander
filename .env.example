# Optional. Defaults to ./data/homelab.db
HOMELAB_DATABASE_PATH=./data/homelab.db

# Keep the default loopback binding unless you intentionally expose the app on a trusted LAN.
HOSTNAME=127.0.0.1
PORT=3000

# Optional defense-in-depth when access is intentionally exposed beyond this
# machine. Use at least 24 random characters and put TLS in front on a LAN.
# HOMELAB_ACCESS_USERNAME=homelab
# HOMELAB_ACCESS_TOKEN=replace-with-a-long-random-secret

# Automated backups. `npm run backup` uses these values; Docker Compose also
# runs a network-isolated backup sidecar with the same retention defaults.
# HOMELAB_BACKUP_DIRECTORY=./backups
# HOMELAB_BACKUP_RETENTION=14
# HOMELAB_BACKUP_INTERVAL_HOURS=24

# Optional always-on Live Mode collector. It remains idle in Demo Mode and is
# always disabled on Vercel. Keep the bounded interval at 30 seconds or longer.
# HOMELAB_COLLECTOR_ENABLED=1
# HOMELAB_COLLECTOR_INTERVAL_SECONDS=60

# Optional provider registry. Copy config/providers.example.json to the ignored
# config/providers.json, then use only secret references in that file.
# HOMELAB_PROVIDER_CONFIG_PATH=./config/providers.json

# Secret references may resolve from HOMELAB_SECRET_* environment variables or
# from the macOS Keychain. Never place an actual token in providers.json.
# HOMELAB_SECRET_PROMETHEUS_TOKEN=replace-locally-only

# Optional alert delivery. Values are secret references, not credentials.
# HOMELAB_NTFY_URL=https://192.168.10.20/homelab
# HOMELAB_NTFY_TOKEN_REF=env:HOMELAB_SECRET_NTFY_TOKEN
# HOMELAB_SLACK_WEBHOOK_REF=env:HOMELAB_SECRET_SLACK_WEBHOOK
