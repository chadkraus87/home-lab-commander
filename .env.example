# Optional. Defaults to ./data/homelab.db
HOMELAB_DATABASE_PATH=./data/homelab.db

# Keep the default loopback binding unless you intentionally expose the app on a trusted LAN.
HOSTNAME=127.0.0.1
PORT=3000

# Optional defense-in-depth when access is intentionally exposed beyond this
# machine. Use at least 24 random characters and put TLS in front on a LAN.
# HOMELAB_ACCESS_USERNAME=homelab
# HOMELAB_ACCESS_TOKEN=replace-with-a-long-random-secret

# Automated backups. `npm run backup` uses these values; Docker Compose also
# runs a network-isolated backup sidecar with the same retention defaults.
# HOMELAB_BACKUP_DIRECTORY=./backups
# HOMELAB_BACKUP_RETENTION=14
# HOMELAB_BACKUP_INTERVAL_HOURS=24

# Optional defense-in-depth when access is intentionally exposed beyond this
# machine. Use at least 24 random characters and put TLS in front on a LAN.
# HOMELAB_ACCESS_USERNAME=homelab
# HOMELAB_ACCESS_TOKEN=replace-with-a-long-random-secret
